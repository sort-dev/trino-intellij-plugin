<drivers>
  <!-- Trino under the Trino (Brikk) dialect, official io.trino:trino-jdbc driver via OUR pinned
       artifact (config/trino-brikk-artifacts.xml) so driver auto-download always matches the
       trino-parser version this plugin bundles and is graded against (483).

       AUTH MODEL (user directive + driver facts): a Trino server WITHOUT TLS MUST NOT use
       username/password auth — trino-jdbc hard-errors if a password is sent without SSL. The
       right insecure-mode identity is the `sessionUser` parameter. The default template maps the
       dialog's User field onto `sessionUser=` in the URL; the Password field MUST stay EMPTY on
       this template (drivers.xml cannot hide/relabel the stock fields — quack lesson; a
       DatabaseAuthProvider panel is the eventual fix). The TLS template uses real user/password
       auth over SSL.

       Template DSL (TrinoDriverTemplateParseTest guards this headless): the query string MUST use
       the `[\?<&,k=v,...>]` group form — a `\?`-escaped literal question mark opening a group
       whose present items join with `&`. A bare `?`/`&` makes JdbcTemplateParser emit an error and
       the connection dialog silently falls back to "URL only" with NO host/port fields (first-touch
       bug, 0.1.0). Field names must be the parser's known locations (host/port/database/schema/
       user/password/...); for Trino `{database}` IS the catalog (dialog labels it "Database"). -->
  <driver id="trino-brikk" name="Trino (Brikk)" dialect="TrinoBrikk"
          forced-dbms="TRINO_BRIKK" driver-class="io.trino.jdbc.TrinoDriver"
          icon="/icons/trino.svg">
    <url-template name="default (no TLS — sessionUser, leave Password empty)"
      template="jdbc:trino://{host::localhost}[:{port::8080}][/{database}[/{schema}]][\?&lt;&amp;,sessionUser={user:param},{:identifier}={:param}&gt;]"/>
    <url-template name="TLS + password"
      template="jdbc:trino://{host::localhost}[:{port::443}][/{database}[/{schema}]][\?&lt;&amp;,SSL=true,user={user:param},password={password:param},{:identifier}={:param}&gt;]"/>
    <artifact name="Trino JDBC (Brikk)" use="true" rolling="true"/>
    <option name="auto-sync" value="true"/>
  </driver>
</drivers>
