<drivers>
  <!-- Trino under the Trino (sort.dev) dialect, official io.trino:trino-jdbc driver via OUR pinned
       artifact (config/trino-brikk-artifacts.xml) so driver auto-download always matches the
       trino-parser version this plugin bundles and is graded against (483).

       NAME: "Trino (sort.dev)", NOT bare "Trino" — DataGrip SHIPS a stock generic "Trino" driver
       (io.trino.jdbc.TrinoDriver, no dialect); a bare name collides with it in the drivers list.
       "(sort.dev)" matches the dialect label and marks this as the one carrying our SQL support.
       DataGrip seeds a new data source's default name from the driver name, so new sources default
       to "Trino (sort.dev)". id trino-brikk + forced-dbms stay stable.

       AUTH MODEL (user directive + driver facts): a Trino server WITHOUT TLS MUST NOT use
       username/password auth — trino-jdbc hard-errors if a password is sent without SSL. The right
       insecure-mode identity is the `sessionUser` parameter. The default template maps the dialog's
       User field onto `sessionUser=`; the Password field stays EMPTY on it. The SSL template uses
       real user/password auth over TLS.

       TEMPLATE SHAPE mirrors JetBrains' own working Trino template (host+port structured editor):
       `{host::localhost}?[:{port::N}][\?<&,k=v,...>]` — note the `?` right after the host field and
       the `[\?<&,...>]` query group (a `\?`-escaped literal `?` opening an `&`-joined group). A bare
       `?`/`&`, or an unknown location field, drops the dialog to "URL only" with no host/port
       (0.1.0 first-touch bug). CATALOG/SCHEMA are DELIBERATELY NOT in the URL — pick them in code
       (`USE cat.schema`) / the Schemas tab; keeping the connection to host+port only. -->
  <driver id="trino-brikk" name="Trino (sort.dev)" dialect="TrinoBrikk"
          forced-dbms="TRINO_BRIKK" driver-class="io.trino.jdbc.TrinoDriver"
          icon="/icons/trino.svg">
    <url-template name="default"
      template="jdbc:trino://{host::localhost}?[:{port::8080}][\?&lt;&amp;,sessionUser={user:param},{:identifier}={:param}&gt;]"/>
    <!-- SSL: default port 8443 (Trino's HTTPS default). SSL is intentionally NOT baked into the URL
         — enable it on the SSH/SSL tab (check "Use SSL"; for a private CA add the cert there). The
         platform TrinoJdbcHelper (registered in plugin.xml) maps that to trino-jdbc's real props
         (SSL / SSLTrustStorePath / SSLTrustStoreType / SSLVerification). Baking SSL=true in the URL
         collides with the tab's property — trino-jdbc: "Connection property SSL is passed both by
         URL and properties." Auth (user/password) rides the Authentication fields as properties. -->
    <url-template name="SSL"
      template="jdbc:trino://{host::localhost}?[:{port::8443}][\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
    <artifact name="Trino JDBC (Brikk)" use="true" rolling="true"/>
    <option name="auto-sync" value="true"/>
  </driver>
</drivers>
